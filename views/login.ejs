<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Renovacell</title>
    <link rel="stylesheet" href="/css/estilos-lp.css">
</head>
<body class="auth-body">
    <div class="auth-overlay">
        <div class="auth-card">
            <div class="logo-container">
                <img src="/img/logo.png" alt="Renovacell Logo" class="logo-img">
            </div>

            <form action="/login" method="POST" class="auth-form">
                <input type="email" name="email" placeholder="E-mail..." required>
                <input type="password" name="senha" placeholder="Senha..." required>
                <button type="submit" class="btn-primary">Acessar</button>
            </form>

            <p class="auth-link">Não tem uma conta? <a href="/registro">Cadastre-se</a></p>
        </div>
    </div>
</body>
</html>